{
  "name": "system-telemetry-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A local mock system telemetry dashboard",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"public/**/*.{html,css,js}\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"public/**/*.{html,css,js}\" \"*.json\" \"*.md\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.6.2",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
