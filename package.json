{
  "name": "system-telemetry-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A multi-user compute operations dashboard with PostgreSQL persistence",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:cleanup": "tsx src/db/retention.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"public/**/*.{html,css,js}\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"public/**/*.{html,css,js}\" \"*.json\" \"*.md\""
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.16",
    "@faker-js/faker": "^10.6.0",
    "better-auth": "^1.7.16",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.6.2",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
