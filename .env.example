NODE_ENV=development
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Comma-separated emails allowed to manage OIDC/SAML provider registration.
ADMIN_EMAILS=admin@example.com

# Optional Google OAuth. Configure the authorized redirect URI as
# https://YOUR_HOST/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production for account verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pulse <no-reply@example.com>

# Optional PostgreSQL pool size; defaults to 10.
DATABASE_POOL_SIZE=10
