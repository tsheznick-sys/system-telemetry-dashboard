import asyncio
import logging
import random
import time

logging.basicConfig(level=logging.INFO, format="%(asctime)s [DB_POOL] %(message)s")

class DatabaseConnection:
    def __init__(self, conn_id: int):
        self.conn_id = conn_id
        self.healthy = True

    async def execute_query(self, query: str):
        await asyncio.sleep(random.uniform(0.1, 0.3))
        logging.info(f"Connection #{self.conn_id} executed query: '{query}'")

class ConnectionPool:
    def __init__(self, max_connections: int = 3):
        self.max_connections = max_connections
        self.pool = asyncio.Queue(maxsize=max_connections)
        for i in range(1, max_connections + 1):
            self.pool.put_nowait(DatabaseConnection(i))

    async def acquire(self) -> DatabaseConnection:
        conn = await self.pool.get()
        if not conn.healthy:
            logging.warning(f"Recycling unhealthy connection #{conn.conn_id}")
            conn = DatabaseConnection(conn.conn_id)
        return conn

    async def release(self, conn: DatabaseConnection):
        await self.pool.put(conn)

async def worker_task(pool: ConnectionPool, worker_id: int):
    conn = await pool.acquire()
    try:
        await conn.execute_query(f"SELECT * FROM telemetry_nodes WHERE worker={worker_id}")
    finally:
        await pool.release(conn)

async def main():
    pool = ConnectionPool(max_connections=2)
    workers = [worker_task(pool, i) for i in range(1, 6)]
    await asyncio.gather(*workers)
    logging.info("All connection pool operations concluded.")

if __name__ == "__main__":
    asyncio.run(main())
    